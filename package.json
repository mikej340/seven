{
  "name": "seven-word-puzzle",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "npm run build:pages",
    "build:pages": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH=/seven NEXT_PUBLIC_SITE_URL=https://mikej340.github.io/seven/ CANONICAL_SITE_URL=https://playseven.uk/ NEXT_PUBLIC_UMAMI_DOMAIN=mikej340.github.io next build",
    "build:root": "GITHUB_PAGES=true NEXT_PUBLIC_BASE_PATH= NEXT_PUBLIC_SITE_URL=https://playseven.uk/ NEXT_PUBLIC_UMAMI_DOMAIN=playseven.uk next build",
    "test": "npm run test:pages",
    "test:pages": "npm run test:unit && npm run build:pages && node --test tests/static-export.test.mjs",
    "test:root": "npm run test:unit && npm run build:root && node --test tests/static-export-root.test.mjs",
    "test:unit": "node --experimental-strip-types --test tests/analytics.test.ts tests/feedback.test.ts tests/game-rules.test.ts tests/game-save.test.ts tests/puzzles.test.ts tests/score-snapshots.test.ts tests/share-invite.test.ts tests/share-score.test.ts tests/responsive-styles.test.mjs",
    "test:storage": "node --experimental-strip-types --test tests/game-save.test.ts",
    "lint": "eslint ."
  },
  "dependencies": {
    "@formspree/react": "^3.0.0",
    "next": "16.4.3",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "type": "module",
  "displayName": "Seven Word Puzzle"
}
